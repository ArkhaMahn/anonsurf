#!/usr/bin/make -f

%:
	dh $@ --with bash-completion

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start anonsurfd.service
	dh_installsystemd anonsurf-recovery.service
override_dh_auto_build:
	make build GO-BUILD-MODE=gopath

override_dh_auto_test:

override_dh_fixperms:
	dh_fixperms
	chmod +x debian/anonsurf/usr/lib/anonsurf/anondaemon
	chmod +x debian/anonsurf/usr/lib/anonsurf/make-torrc
	chmod +x debian/anonsurf/usr/lib/anonsurf/safekill

override_dh_auto_install:
